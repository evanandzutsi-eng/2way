{
  "name": "2way",
  "version": "1.0.0",
  "private": true,
  "description": "2WaY — a private social lounge for an invited circle of friends.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20.11"
  },
