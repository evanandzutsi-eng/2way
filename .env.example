# Copy to .env and fill in. Never commit .env.

# Public hostname. DNS A/AAAA records must point at this server before first start
# so Caddy can obtain the HTTPS certificate.
DOMAIN=2way.example.com
ACME_EMAIL=you@example.com

# Long random values: `openssl rand -base64 32`
POSTGRES_PASSWORD=change-me
# Encrypts backups. Store a copy somewhere safe OFF this server — without it,
# backups cannot be restored.
BACKUP_PASSPHRASE=change-me-too

BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=2

# Local day boundary for daily XP and streaks.
APP_TIMEZONE=Africa/Lagos
LOG_LEVEL=info
